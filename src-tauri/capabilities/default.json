{
  "identifier": "media-default",
  "description": "สิทธิ์พื้นฐานของ Lalin Cast WebView, DIAL bridge และ updater",
  "windows": ["media"],
  "remote": {
    "urls": ["https://www.youtube.com/*"]
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-dial-respond",
    "allow-dial-set-device-id",
    "allow-cast-update-check",
    "allow-cast-update-install"
  ]
}
